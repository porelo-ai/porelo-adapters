<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-adapter-parent</artifactId>
        <version>0.5.1-SNAPSHOT</version>
    </parent>

    <artifactId>porelo-adapter-github</artifactId>
    <name>Porelo GitHub Adapter</name>
    <description>Porelo - Reads what the build of a task's push did on GitHub Actions</description>

    <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-adapter-http</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- compile: the build API and the wire it speaks, and nothing else of Porelo's. -->

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-build-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-wire</artifactId>
        </dependency>

        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!-- The GitHub calls of reviews and their conversion to Porelo's review profile. -->

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-forge-client-github</artifactId>
            <version>${porelo.forge-clients.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-footnotes</artifactId>
            <version>${commonmark.version}</version>
        </dependency>

        <!-- test -->

        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-build-contract</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <profiles>
        <!-- The executable Porelo starts: mvn -Pnative package writes target/porelo-adapter-github, installed as
             /usr/libexec/porelo/builds/github, the name a project file gives the forge. -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>${native-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-porelo-adapter-github</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <configuration>
                                    <imageName>porelo-adapter-github</imageName>
                                    <mainClass>org.fuin.porelo.build.github.GitHubReader</mainClass>
                                    <fallback>false</fallback>
                                    <buildArgs>
                                        <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                        <!-- x86-64 v1, so it starts on any x86-64 CPU, not only the build host's. -->
                                        <buildArg>-march=x86-64</buildArg>
                                    </buildArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- The packages: -Pnative,dist verify. The native reader as /usr/libexec/porelo/builds/github, where porelo
             finds the reader a project names with 'builds: { forge: github }'. -->
        <profile>
            <id>dist</id>
            <properties>
                <package.name>porelo-adapter-github</package.name>
                <builds.install.dir>/usr/libexec/porelo/builds</builds.install.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-version</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>regex-property</goal>
                                </goals>
                                <configuration>
                                    <!-- '~' sorts below everything in dpkg and rpm, so 0.4.2~snapshot.N is older than
                                         0.4.2, and the run number makes each snapshot newer than the last. -->
                                    <name>reader.package.version</name>
                                    <value>${project.version}</value>
                                    <regex>-SNAPSHOT$</regex>
                                    <replacement>~snapshot.${reader.snapshot.run}</replacement>
                                    <failIfNoMatch>false</failIfNoMatch>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>


                    <plugin>
                        <groupId>org.vafer</groupId>
                        <artifactId>jdeb</artifactId>
                        <executions>
                            <execution>
                                <id>deb</id>
                                <!-- Not 'package': native-image binds there too. -->
                                <phase>verify</phase>
                                <goals>
                                    <goal>jdeb</goal>
                                </goals>
                                <configuration>
                                    <name>${package.name}</name>
                                    <deb>${project.build.directory}/${package.name}_${reader.package.version}_amd64.deb</deb>
                                    <controlDir>${project.basedir}/src/deb/control</controlDir>
                                    <dataSet>
                                        <data>
                                            <src>${project.build.directory}/porelo-adapter-github</src>
                                            <type>file</type>
                                            <dst>github</dst>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>${builds.install.dir}</prefix>
                                                <filemode>755</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                        <!-- Debian Policy 12.5: every binary package ships one. -->
                                        <data>
                                            <src>${project.basedir}/src/deb/copyright/copyright</src>
                                            <type>file</type>
                                            <mapper>
                                                <type>perm</type>
                                                <prefix>/usr/share/doc/${package.name}</prefix>
                                                <filemode>644</filemode>
                                                <user>root</user>
                                                <group>root</group>
                                            </mapper>
                                        </data>
                                    </dataSet>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>de.dentrassi.maven</groupId>
                        <artifactId>rpm</artifactId>
                        <executions>
                            <execution>
                                <id>rpm</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>rpm</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <packageName>${package.name}</packageName>
                            <version>${reader.package.version}</version>
                            <snapshotVersion>${reader.package.version}</snapshotVersion>
                            <release>1</release>
                            <summary>Porelo's build reader for GitHub Actions</summary>
                            <description>Reads a task's builds on GitHub Actions for Porelo. Installs into /usr/libexec/porelo/builds as 'github', where porelo finds it.</description>
                            <!-- Without this a snapshot gets a timestamp release, and the rpm and the deb disagree. -->
                            <forceRelease>true</forceRelease>
                            <architecture>x86_64</architecture>
                            <group>Applications/System</group>
                            <license>GPL-3.0-or-later</license>
                            <packager>Michael Schnell &lt;michael@fuin.org&gt;</packager>
                            <obsoletes>
                                <obsolete>porelo-build-github</obsolete>
                            </obsoletes>
                            <requires>
                                <require>porelo</require>
                                <!-- The names rpmbuild itself generates for these libraries. -->
                                <require>libc.so.6(GLIBC_${package.glibc.floor})(64bit)</require>
                                <require>libz.so.1(ZLIB_${package.zlib.floor})(64bit)</require>
                            </requires>
                            <signature>
                                <skip>true</skip>
                            </signature>
                            <entries>
                                <entry>
                                    <name>${builds.install.dir}/github</name>
                                    <file>${project.build.directory}/porelo-adapter-github</file>
                                    <mode>0755</mode>
                                    <user>root</user>
                                    <group>root</group>
                                </entry>
                                <!-- 'license' marks it %license, so 'rpm -qL' answers. -->
                                <entry>
                                    <name>/usr/share/licenses/${package.name}/LICENSE</name>
                                    <file>${maven.multiModuleProjectDirectory}/LICENSE</file>
                                    <mode>0644</mode>
                                    <user>root</user>
                                    <group>root</group>
                                    <license>true</license>
                                </entry>
                            </entries>
                        </configuration>
                    </plugin>

                    <!-- Declared after both packages, since all bind to verify and run in this order: the reader
                         against what the packages declare, then what the packages say their version is. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>check-linkage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-linkage --declare libc.so.6=GLIBC:${package.glibc.floor} --declare libz.so.1=ZLIB:${package.zlib.floor} --ceiling GLIBC=${package.glibc.ceiling} ${project.build.directory}/porelo-adapter-github</commandlineArgs>
                                </configuration>
                            </execution>
                            <execution>
                                <id>check-package-version</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <includeProjectDependencies>false</includeProjectDependencies>
                                    <includePluginDependencies>true</includePluginDependencies>
                                    <executableDependency>
                                        <groupId>org.fuin.porelo</groupId>
                                        <artifactId>porelo-release</artifactId>
                                    </executableDependency>
                                    <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-package-version ${package.name} ${project.version} ${reader.snapshot.run} ${project.build.directory}</commandlineArgs>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
        <dependency>
            <groupId>org.fuin.porelo</groupId>
            <artifactId>porelo-adapter-http</artifactId>
            <version>${project.version}</version>
        </dependency>
                            <dependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                                <version>${porelo.buildtools.version}</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <!-- The review conversion names the adapter's real build version, written here by the build. -->
        <resources>
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

</project>
