{
  "version": "2.1.0",
  "properties": {
    "porelo/profileVersion": "1"
  },
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "github"
        }
      },
      "conversion": {
        "tool": {
          "driver": {
            "name": "porelo-adapter-github",
            "version": "0.5.1-SNAPSHOT"
          }
        }
      },
      "versionControlProvenance": [
        {
          "repositoryUri": "${repositoryUri}",
          "revisionId": "${head}"
        }
      ],
      "columnKind": "unicodeCodePoints",
      "properties": {
        "porelo/baseRevisionId": "${base}",
        "porelo/completeness": "complete",
        "porelo/forgeInstanceId": "github.com",
        "porelo/pullRequestId": "17",
        "porelo/nativeRepositoryId": "88127341",
        "porelo/fromFork": "true"
      },
      "results": [
        {
          "kind": "review",
          "level": "none",
          "message": {
            "text": "Please review the approval check before accepting this contribution."
          },
          "hostedViewerUri": "https://github.com/example-org/review-demo/pull/17#issuecomment-9000000049",
          "properties": {
            "porelo/anchorKind": "general",
            "porelo/sourceKind": "forge",
            "porelo/forgeInstanceId": "github.com",
            "porelo/authorId": "9000000050",
            "porelo/authorDisplayName": "fixture-reviewer",
            "porelo/authorNodeId": "U_fixture0050",
            "porelo/authorType": "user",
            "porelo/authorAssociation": "NONE",
            "porelo/authorMember": "unknown",
            "porelo/nativeCommentId": "9000000049",
            "porelo/nativeCommentKind": "issue",
            "porelo/nativeCommentNodeId": "IC_fixture0049",
            "porelo/draft": false
          }
        }
      ]
    }
  ]
}
